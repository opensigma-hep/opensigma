{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "colliders.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "beams", "sqrts_gev", "status", "order"],
    "properties": {
      "id": {"$ref": "common.schema.json#/$defs/id", "pattern": "^col:"},
      "name": {"type": "string", "minLength": 1},
      "beams": {"type": "string"},
      "sqrts_gev": {
        "anyOf": [
          {"type": "number", "exclusiveMinimum": 0},
          {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 2, "maxItems": 2}
        ]
      },
      "status": {"enum": ["past", "running", "future"]},
      "order": {"type": "integer"}
    }
  }
}
