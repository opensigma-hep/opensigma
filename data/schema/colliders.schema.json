{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "colliders.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "beams", "sqrts_gev", "status", "order"],
    "properties": {
      "id": {"$ref": "common.schema.json#/$defs/id", "pattern": "^col:"},
      "name": {"type": "string", "minLength": 1},
      "beams": {"type": "string"},
      "sqrts_gev": {
        "anyOf": [
          {"type": "number", "exclusiveMinimum": 0},
          {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 2, "maxItems": 2}
        ]
      },
      "status": {"enum": ["past", "running", "future"]},
      "order": {"type": "integer"},
      "machine": {"type": "string", "minLength": 1, "description": "the accelerator this entry is a running period or stage of"},
      "lab": {"type": "string", "minLength": 1},
      "years": {"type": "string", "minLength": 1},
      "url": {"$ref": "experiments.schema.json#/$defs/url", "description": "official machine/project page; the source of the optional facts"},
      "note": {"type": "string", "minLength": 1},
      "luminosity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source"],
        "properties": {"text": {"type": "string", "minLength": 1}, "source": {"$ref": "experiments.schema.json#/$defs/url"}}
      },
      "sources": {"$ref": "experiments.schema.json#/$defs/urls"}
    }
  }
}
