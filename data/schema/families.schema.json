{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "families.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "sector", "order"],
    "properties": {
      "id": {"$ref": "common.schema.json#/$defs/id", "pattern": "^fam:"},
      "name": {"type": "string", "minLength": 1},
      "sector": {"const": "SM"},
      "order": {"type": "integer"},
      "maintainers": {"type": "array", "items": {"type": "string"}}
    }
  }
}
