{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parameter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "symbol", "unit", "determinations"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id", "pattern": "^par:"},
    "name": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "unit": {"type": "string"},
    "aliases": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id", "pattern": "^par:"}},
    "determinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "uncertainty", "extracted_from", "ref", "provenance"],
        "properties": {
          "value": {"type": "number"},
          "uncertainty": {"type": "number"},
          "extracted_from": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id", "pattern": "^(obs|meas):"}},
          "ref": {"$ref": "common.schema.json#/$defs/ref"},
          "provenance": {"$ref": "common.schema.json#/$defs/provenance"}
        }
      }
    }
  }
}
