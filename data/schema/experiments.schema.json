{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiments.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiments", "groups"],
  "properties": {
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "description"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id", "pattern": "^exp:"},
          "name": {"type": "string", "minLength": 1, "description": "the string used as `experiment:` in measurements"},
          "full_name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["experiment", "facility", "combination"]},
          "colliders": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id", "pattern": "^col:"}, "uniqueItems": true},
          "status": {"enum": ["active", "completed", "planned"]},
          "years": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "links": {"$ref": "#/$defs/links"},
          "sources": {"$ref": "#/$defs/urls"}
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "links"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id", "pattern": "^grp:"},
          "name": {"type": "string", "minLength": 1},
          "full_name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "links": {"$ref": "#/$defs/links", "minItems": 1},
          "sources": {"$ref": "#/$defs/urls"}
        }
      }
    }
  },
  "$defs": {
    "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "urls": {"type": "array", "items": {"$ref": "#/$defs/url"}, "uniqueItems": true},
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {"label": {"type": "string", "minLength": 1}, "url": {"$ref": "#/$defs/url"}}
      }
    }
  }
}
